---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeroBackdrop from '../../components/HeroBackdrop.astro';
import company from '../../data/company.json';
import regions from '../../data/regions.json';
import services from '../../data/services.json';

const canonical = `${company.site}/uslugi/`;
const serviceList = Object.values(services) as any[];
const regionsList = Object.values(regions) as any[];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${company.site}/#org`,
      name: company.legalName,
      alternateName: company.name,
      url: `${company.site}/`,
      telephone: company.phone,
      email: company.email,
      foundingDate: company.founded,
      address: { '@type': 'PostalAddress', ...company.legalAddress },
      location: { '@type': 'PostalAddress', ...company.workAddress },
      identifier: [
        { '@type': 'PropertyValue', name: 'ИНН', value: company.inn },
        { '@type': 'PropertyValue', name: 'ОГРН', value: company.ogrn }
      ],
      hasCredential: [
        { '@type': 'EducationalOccupationalCredential', credentialCategory: 'СРО строительство', name: company.sro.construction.name, identifier: company.sro.construction.number },
        { '@type': 'EducationalOccupationalCredential', credentialCategory: 'СРО проектирование', name: company.sro.design.name, identifier: company.sro.design.number },
        { '@type': 'EducationalOccupationalCredential', credentialCategory: 'Лицензия МЧС', identifier: company.license.mchs }
      ],
      contactPoint: { '@type': 'ContactPoint', telephone: company.phone, contactType: 'customer service', areaServed: 'RU', availableLanguage: 'ru' }
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Главная', item: `${company.site}/` },
        { '@type': 'ListItem', position: 2, name: 'Услуги', item: canonical }
      ]
    },
    {
      '@type': 'ItemList',
      name: `Услуги ${company.legalName}`,
      numberOfItems: serviceList.length,
      itemListElement: serviceList.map((svc, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: svc.title,
        description: svc.tagline,
        url: `${company.site}/uslugi/${svc.slug}/`
      }))
    }
  ]
};
---

<BaseLayout
  title={`Услуги ${company.name} — строительство и монтаж объектов нефтегаза в Коми и НАО`}
  description={`Все услуги ${company.legalName}: ${serviceList.map(s => s.title).join(', ')}. Работаем в Республике Коми и НАО с ${company.founded} года. СРО, лицензия МЧС, электролаборатория ${company.electricLab}.`}
  canonical={canonical}
  jsonLd={jsonLd}
>

<nav class="crumbs" aria-label="Хлебные крошки">
  <a href="/">Главная</a>
  <span class="sep">›</span>
  <span aria-current="page">Услуги</span>
</nav>

<main>

<section class="hero hero-featured" aria-labelledby="hero-title">
  <HeroBackdrop />
  <div class="hero-badge">{serviceList.length} направлений работ</div>
  <h1 id="hero-title">Услуги <em>{company.name}</em></h1>
  <p class="hero-sub">
    {company.legalName} с {company.founded} года выполняет строительство, монтаж и пуско-наладку
    объектов нефтегазового комплекса в Республике Коми и Ненецком автономном округе.
    Собственная электролаборатория {company.electricLab}, допуски СРО на строительство и проектирование,
    лицензия МЧС на противопожарные системы.
  </p>

  <div class="trust-strip">
    <span class="trust-chip"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>СРО строительство</span>
    <span class="trust-chip"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>СРО проектирование</span>
    <span class="trust-chip"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>Лицензия МЧС</span>
  </div>

  <div class="cta-group">
    <a href={`tel:${company.phoneTel}`} class="btn btn-primary">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.8 19.8 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.37 1.9.72 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.35 1.85.59 2.81.72A2 2 0 0 1 22 16.92z"/></svg>
      {company.phoneDisplay}
    </a>
  </div>
</section>

<section aria-labelledby="services-title">
  <span class="section-label">Направления</span>
  <h2 id="services-title" class="section-title">Что делает НМА</h2>
  <div class="services">
    {serviceList.map(svc => (
      <a href={`/uslugi/${svc.slug}/`} class="svc" style="color:inherit;text-decoration:none;display:block">
        <h3>{svc.title}</h3>
        <p>{svc.shortDescription}</p>
        <span class="svc-tag">{svc.stats[0].num} {svc.stats[0].label}</span>
      </a>
    ))}
  </div>
</section>

<section aria-labelledby="geo-title">
  <span class="section-label">География</span>
  <h2 id="geo-title" class="section-title">Где работаем</h2>
  <div class="services">
    {regionsList.map(r => (
      <a href={`/${r.slug}/`} class="svc" style="color:inherit;text-decoration:none;display:block">
        <h3>{r.nameFull}</h3>
        <p>{r.description}</p>
        <span class="svc-tag">{r.cities.length} {r.cities.length === 1 ? 'город' : 'городов'}</span>
      </a>
    ))}
  </div>
</section>

<section id="contact" aria-labelledby="contact-title">
  <span class="section-label">Контакты</span>
  <h2 id="contact-title" class="section-title">Обсудить задачу</h2>
  <div class="contact-card">
    <h3>{company.name} · {company.workAddress.addressLocality}</h3>
    <div class="contact-item">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.8 19.8 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.37 1.9.72 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.35 1.85.59 2.81.72A2 2 0 0 1 22 16.92z"/></svg>
      <div><a href={`tel:${company.phoneTel}`}>{company.phoneDisplay}</a><small>{company.hours.display}</small></div>
    </div>
    <div class="contact-item">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><path d="M22 6l-10 7L2 6"/></svg>
      <div><a href={`mailto:${company.email}`}>{company.email}</a></div>
    </div>
    <div class="contact-item">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-8-4.5-8-11a8 8 0 0 1 16 0c0 6.5-8 11-8 11z"/><circle cx="12" cy="10" r="3"/></svg>
      <div>{company.workAddress.addressLocality}, {company.workAddress.streetAddress}<small>{company.workAddress.addressRegion}</small></div>
    </div>
  </div>
</section>

</main>
</BaseLayout>
