---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import HeroBackdrop from '../../../components/HeroBackdrop.astro';
import company from '../../../data/company.json';
import { organization } from '../../../data/organization';
import regions from '../../../data/regions.json';
import cities from '../../../data/cities.json';
import services from '../../../data/services.json';

export async function getStaticPaths() {
  const paths = [];
  for (const [regionKey, region] of Object.entries(regions)) {
    for (const [serviceKey, service] of Object.entries(services)) {
      for (const cityKey of region.cities) {
        const city = (cities as any)[cityKey];
        if (!city) continue;
        paths.push({
          params: { region: regionKey, service: serviceKey, city: cityKey },
          props: { region, service, city }
        });
      }
    }
  }
  return paths;
}

const { region, service, city } = Astro.props;

const replace = (s: string) => (s || '')
  .replaceAll('{city}', city.namePrepositional)
  .replaceAll('{cityName}', city.name)
  .replaceAll('{cityGen}', city.nameGenitive)
  .replaceAll('{region}', region.namePrepositional)
  .replaceAll('{regionName}', region.name)
  .replaceAll('{regionGen}', region.nameGenitive)
  .replaceAll('{heroNote}', city.heroNote || '');

const canonical = `${company.site}/${region.slug}/${service.slug}/${city.slug}/`;
const pageTitle = replace(service.metaTitle);
const pageDescription = replace(service.metaDescription);
const keywords = (service.keywordsSeeds || []).map(replace).join(', ');

const iconSvg: Record<string, string> = {
  bolt: '<path d="M13 2L3 14h7l-1 8 10-12h-7l1-8z"/>',
  tower: '<path d="M12 2v20M6 22l6-20 6 20M4 22h16M7 10h10M5 16h14"/>',
  lamp: '<path d="M9 18h6M10 22h4M12 2a7 7 0 0 1 4 12.7V17H8v-2.3A7 7 0 0 1 12 2z"/>',
  building: '<rect x="4" y="2" width="16" height="20" rx="1"/><path d="M8 6h2M8 10h2M8 14h2M14 6h2M14 10h2M14 14h2M10 22v-4h4v4"/>',
  chip: '<rect x="5" y="5" width="14" height="14" rx="2"/><path d="M9 9h6v6H9zM4 9h2M4 15h2M18 9h2M18 15h2M9 4v2M15 4v2M9 18v2M15 18v2"/>',
  wrench: '<path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>',
  pipe: '<path d="M4 12h6M14 12h6M10 6v12M14 6v12"/><circle cx="10" cy="12" r="3"/><circle cx="14" cy="12" r="3"/>',
  flame: '<path d="M12 2s4 4 4 9a4 4 0 0 1-8 0c0-2 1-3 1-3s-3 2-3 6a6 6 0 0 0 12 0c0-7-6-12-6-12z"/>',
  shield: '<path d="M20 12a8 8 0 1 1-16 0 8 8 0 0 1 16 0z"/><path d="M12 8v4l3 2"/>',
  badge: '<path d="M12 2l9 4v6c0 5-3.8 9.5-9 10-5.2-.5-9-5-9-10V6l9-4z"/>',
  compass: '<circle cx="12" cy="12" r="10"/><path d="M16 8l-2 6-6 2 2-6 6-2z"/>',
  gear: '<circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.9l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.9-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 0 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.9.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.9 1.7 1.7 0 0 0-1.5-1H3a2 2 0 0 1 0-4h.1a1.7 1.7 0 0 0 1.5-1.1 1.7 1.7 0 0 0-.3-1.9l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.9.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 0 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.9-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.9V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 0 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1z"/>',
  drill: '<path d="M14 3h5v5M19 3l-7 7M8 20l-5-1 1-5 6-6 5 5-7 7z"/>',
  monitor: '<rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/>',
  cable: '<rect x="3" y="8" width="18" height="8" rx="2"/><path d="M7 8V4h10v4M7 16v4h10v-4"/>',
  plug: '<path d="M9 2v6M15 2v6M6 10h12v3a6 6 0 0 1-12 0v-3zM12 19v3"/>'
};

const heroIcon = service.heroIcon || 'badge';

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    organization,

    {
      '@type': 'Service',
      '@id': `${canonical}#service`,
      serviceType: service.schemaServiceType || service.title,
      provider: { '@id': `${company.site}/#org` },
      areaServed: [
        { '@type': 'City', name: city.name },
        { '@type': 'AdministrativeArea', name: region.nameFull }
      ],
      description: service.shortDescription,
      name: `${service.title} в ${city.namePrepositional}`,
      url: canonical
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Главная', item: `${company.site}/` },
        { '@type': 'ListItem', position: 2, name: region.name, item: `${company.site}/${region.slug}/` },
        { '@type': 'ListItem', position: 3, name: service.title, item: `${company.site}/${region.slug}/${service.slug}/` },
        { '@type': 'ListItem', position: 4, name: city.name, item: canonical }
      ]
    },
    {
      '@type': 'FAQPage',
      mainEntity: [...(city.localFaq || []), ...service.faq].map((f: any) => ({
        '@type': 'Question',
        name: replace(f.q),
        acceptedAnswer: { '@type': 'Answer', text: replace(f.a) }
      }))
    }
  ]
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  keywords={keywords}
  canonical={canonical}
  geo={{ region: region.iso, placename: `${city.name}, ${region.nameFull}` }}
  jsonLd={jsonLd}
>

<nav class="crumbs" aria-label="Хлебные крошки">
  <a href="/">Главная</a>
  <span class="sep">›</span>
  <a href={`/${region.slug}/`}>{region.name}</a>
  <span class="sep">›</span>
  <a href={`/${region.slug}/${service.slug}/`}>{service.title}</a>
  <span class="sep">›</span>
  <span aria-current="page">{city.name}</span>
</nav>

<main>

<section class="hero hero-featured" aria-labelledby="hero-title">
  <HeroBackdrop />
  <div class="hero-badge">{service.title} · {region.name}</div>
  <h1 id="hero-title" set:html={replace(service.heroH1)}></h1>
  <p class="hero-sub">{replace(service.heroDescription)}</p>

  <div class="trust-strip">
    {service.trustChips.map((chip: string) => (
      <span class="trust-chip">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
        {chip}
      </span>
    ))}
  </div>

  <div class="cta-group">
    <a href={`tel:${company.phoneTel}`} class="btn btn-primary">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.8 19.8 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.37 1.9.72 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.35 1.85.59 2.81.72A2 2 0 0 1 22 16.92z"/></svg>
      {company.phoneDisplay}
    </a>
    <a href="#request" class="btn btn-secondary">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
      Заявка на выезд
    </a>
  </div>
</section>

<div class="stats">
  {service.stats.map((s: any) => (
    <div class="stat"><div class="stat-num">{s.num}</div><div class="stat-label">{s.label}</div></div>
  ))}
</div>

<section aria-labelledby="what-title">
  <span class="section-label">{service.title}</span>
  <h2 id="what-title" class="section-title">{replace(service.whatTitle)}</h2>
  <p class="section-sub">{replace(service.whatSub)}</p>
  <div class="services">
    {service.items.map((item: any) => (
      <article class="svc">
        <div class="svc-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={iconSvg[item.icon] || iconSvg[heroIcon] || iconSvg.badge}></svg>
        </div>
        <h3>{item.title}</h3>
        <p>{item.desc}</p>
        <span class="svc-tag">{item.tag}</span>
      </article>
    ))}
  </div>
</section>

<section aria-labelledby="how-title">
  <span class="section-label">Процесс</span>
  <h2 id="how-title" class="section-title">{replace(service.howTitle)}</h2>
  <p class="section-sub">{replace(service.howSub)}</p>
  <div class="timeline">
    {service.process.map((step: any, i: number) => (
      <div class="step">
        <span class="step-num">{String(i + 1).padStart(2, '0')}</span>
        <h3>{replace(step.title)}</h3>
        <p>{replace(step.desc)}</p>
      </div>
    ))}
  </div>
</section>

<section aria-labelledby="result-title">
  <span class="section-label">Результат</span>
  <h2 id="result-title" class="section-title">{replace(service.resultTitle)}</h2>
  <div class="results">
    {service.results.map((r: any) => (
      <div class="result-row">
        <div class="result-check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg></div>
        <div><h3>{r.title}</h3><p>{r.desc}</p></div>
      </div>
    ))}
  </div>
</section>

{city.localClients && city.localClients.length > 0 && (
  <section aria-labelledby="local-clients-title">
    <span class="section-label">Промышленность региона</span>
    <h2 id="local-clients-title" class="section-title">Крупные операторы в {city.namePrepositional}</h2>
    <p class="section-sub">Нефтегазовые компании и промышленные предприятия {city.nameGenitive} — предприятия, для которых могут быть востребованы наши направления работ.</p>
    <div class="local-clients">
      {city.localClients.map((c: string) => (
        <div class="local-client">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>
          <span>{c}</span>
        </div>
      ))}
    </div>
  </section>
)}

<section aria-labelledby="geo-title">
  <span class="section-label">Другие города</span>
  <h2 id="geo-title" class="section-title">{service.title} в городах {region.nameGenitive}</h2>
  <div class="cities">
    {region.cities.map((cKey: string) => {
      const c = (cities as any)[cKey];
      if (!c) return null;
      const isCurrent = c.slug === city.slug;
      return (
        <a href={`/${region.slug}/${service.slug}/${c.slug}/`} class={`city ${isCurrent ? 'current' : ''}`} aria-current={isCurrent ? 'page' : undefined}>
          <span class="city-dot"></span>{c.name}
        </a>
      );
    })}
  </div>
</section>

<section aria-labelledby="price-title">
  <span class="section-label">Стоимость</span>
  <h2 id="price-title" class="section-title">{replace(service.priceTitle)}</h2>
  <div class="price-card">
    <h3>{service.priceCardTitle}</h3>
    <p>{replace(service.priceCardDesc)}</p>
    <div class="price-factors">
      {service.priceFactors.map((f: string) => <span>{f}</span>)}
    </div>
    <a href={`tel:${company.phoneTel}`} class="btn btn-primary" style="position:relative">Узнать стоимость</a>
  </div>
</section>

<section aria-labelledby="faq-title">
  <span class="section-label">FAQ</span>
  <h2 id="faq-title" class="section-title">{service.faqTitle || 'Частые вопросы'}</h2>
  <div class="faq">
    {[...(city.localFaq || []), ...service.faq].map((f: any) => (
      <details class="qa">
        <summary>{replace(f.q)}</summary>
        <div class="qa-body">{replace(f.a)}</div>
      </details>
    ))}
  </div>
</section>

<section aria-labelledby="related-title">
  <span class="section-label">Смежные услуги</span>
  <h2 id="related-title" class="section-title">{replace(service.relatedTitle)}</h2>
  <div class="related-list">
    {service.related.map((r: any) => {
      const href = r.hrefTemplate ? r.hrefTemplate.replaceAll('{region}', region.slug) : r.href;
      return (
        <a href={href} class="related-item">
          <span>{r.label}</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
      );
    })}
  </div>
</section>

<section id="request" aria-labelledby="contact-title">
  <span class="section-label">Контакты</span>
  <h2 id="contact-title" class="section-title">{replace(service.contactTitle)}</h2>
  <p class="section-sub">Работы в {city.namePrepositional} организуем с выездом из Усинска. Эта страница описывает территорию обслуживания. <a href="/contacts/">Адреса и реквизиты НМА</a>.</p>
  <div class="contact-card">
    <h3>{company.name} · {city.name}</h3>
    <div class="contact-item">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.8 19.8 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.37 1.9.72 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.35 1.85.59 2.81.72A2 2 0 0 1 22 16.92z"/></svg>
      <div><a href={`tel:${company.phoneTel}`}>{company.phoneDisplay}</a><small>{company.hours.display}</small></div>
    </div>
    <div class="contact-item">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><path d="M22 6l-10 7L2 6"/></svg>
      <div><a href={`mailto:${company.email}`}>{company.email}</a><small>Ответим в рабочее время</small></div>
    </div>
    <div class="contact-item">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0z"/><circle cx="12" cy="10" r="3"/></svg>
      <div>
        <span style="color:var(--text);font-weight:600;font-size:15px">{city.name}, {region.nameFull}</span>
        <small>{service.contactDesc || 'Выезд на объект в Коми и НАО'}</small>
      </div>
    </div>
  </div>
</section>

</main>
</BaseLayout>
