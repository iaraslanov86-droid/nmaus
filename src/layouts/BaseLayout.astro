---
import '../styles/global.css';
import company from '../data/company.json';

export interface Props {
  title: string;
  description: string;
  keywords?: string;
  canonical: string;
  ogImage?: string;
  ogType?: string;
  noindex?: boolean;
  geo?: { region?: string; placename?: string; lat?: number; lon?: number };
  jsonLd?: unknown;
  publishedTime?: string;
  modifiedTime?: string;
}

const {
  title,
  description,
  keywords,
  canonical,
  ogImage = `${company.site}/og/default.jpg`,
  ogType = 'website',
  noindex = false,
  geo,
  jsonLd,
  publishedTime,
  modifiedTime = new Date().toISOString()
} = Astro.props;

const robotsContent = noindex
  ? 'noindex,nofollow'
  : 'index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1';
---
<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
  <meta name="theme-color" content="#0d0b09" />
  <meta name="format-detection" content="telephone=yes" />
  <meta name="HandheldFriendly" content="true" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />

  <title>{title}</title>
  <meta name="description" content={description} />
  {keywords && <meta name="keywords" content={keywords} />}
  <meta name="robots" content={robotsContent} />
  <meta name="author" content={company.legalName} />

  {company.verification?.yandex && <meta name="yandex-verification" content={company.verification.yandex} />}
  {company.verification?.google && <meta name="google-site-verification" content={company.verification.google} />}

  {geo?.region && <meta name="geo.region" content={geo.region} />}
  {geo?.placename && <meta name="geo.placename" content={geo.placename} />}
  {geo?.lat && geo?.lon && <meta name="geo.position" content={`${geo.lat};${geo.lon}`} />}
  {geo?.lat && geo?.lon && <meta name="ICBM" content={`${geo.lat}, ${geo.lon}`} />}

  <link rel="canonical" href={canonical} />
  <link rel="alternate" hreflang="ru" href={canonical} />
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
  <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192x192.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="mask-icon" href="/safari-pinned-tab.svg" color="#f07200" />
  <meta name="msapplication-TileImage" content="/mstile-270x270.png" />
  <meta name="msapplication-TileColor" content="#0d0b09" />
  <link rel="manifest" href="/site.webmanifest" />

  <meta property="og:type" content={ogType} />
  <meta property="og:locale" content="ru_RU" />
  <meta property="og:site_name" content={company.name} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:secure_url" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={title} />
  {publishedTime && <meta property="article:published_time" content={publishedTime} />}
  <meta property="article:modified_time" content={modifiedTime} />
  <meta property="article:author" content={company.legalName} />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
</head>
<body>
  <header class="topbar">
    <div class="topbar-info" aria-hidden="true">
      <div class="topbar-info-inner">
        <span class="info-item">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
          {company.hours.display}
        </span>
        <span class="info-sep" aria-hidden="true">•</span>
        <span class="info-item">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0z"/><circle cx="12" cy="10" r="3"/></svg>
          {company.workAddress.addressLocality}, {company.workAddress.addressRegion}
        </span>
        <span class="info-sep" aria-hidden="true">•</span>
        <span class="info-item">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l9 4v6c0 5-3.8 9.5-9 10-5.2-.5-9-5-9-10V6l9-4z"/></svg>
          СРО · Лицензия МЧС · ЭТЛ&nbsp;35&nbsp;кВ
        </span>
        <span class="info-sep info-sep-far" aria-hidden="true">•</span>
        <span class="info-item info-item-end">с {company.founded} года</span>
      </div>
    </div>

    <div class="topbar-main">
      <div class="topbar-inner">
        <a href="/" class="logo" aria-label={`${company.name} — главная`}>
          <img src="/logo-icon.png" alt="" width="56" height="56" class="logo-img" decoding="async" fetchpriority="high" />
          <span class="logo-text">
            <span class="logo-name">{company.name}</span>
            <span class="logo-sub">{company.fullName}</span>
          </span>
        </a>

        <nav class="topbar-nav" aria-label="Основная навигация">
          <a href="/uslugi/" class="topbar-link">Услуги</a>
          <a href="/about/" class="topbar-link">О&nbsp;компании</a>
          <a href="/komi/" class="topbar-link">Республика&nbsp;Коми</a>
          <a href="/nao/" class="topbar-link">НАО</a>
        </nav>

        <div class="topbar-right">
          <a href={`mailto:${company.email}`} class="topbar-contact" aria-label={`Написать на ${company.email}`}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><path d="M22 6l-10 7L2 6"/></svg>
            <span>{company.email}</span>
          </a>
          <a href={`tel:${company.phoneTel}`} class="topbar-cta" aria-label={`Позвонить ${company.phoneDisplay}`}>
            <span class="cta-pulse" aria-hidden="true"><span class="cta-pulse-dot"></span></span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.8 19.8 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.37 1.9.72 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.35 1.85.59 2.81.72A2 2 0 0 1 22 16.92z"/></svg>
            <span class="cta-text">
              <span class="cta-num">{company.phoneDisplay}</span>
              <span class="cta-hint">Позвонить · бесплатно</span>
            </span>
          </a>
        </div>
      </div>
    </div>

    <div class="topbar-line" aria-hidden="true"></div>
  </header>

  <slot />

  <footer class="site-footer">
    <p><strong>{company.legalName}</strong> — Строительство ВЛ/ЛЭП, энергоцентров, РУ и ПС, нефтепроводов, АСУТП, ПНР и ШМР, электрообогрев, изоляция, ОПС (лицензия МЧС).</p>
    <p>Фактический адрес: {company.workAddress.postalCode}, {company.workAddress.addressRegion}, {company.workAddress.addressLocality}, {company.workAddress.streetAddress}</p>
    <p>Юр. адрес: {company.legalAddress.postalCode}, {company.legalAddress.addressRegion}, {company.legalAddress.addressLocality}, {company.legalAddress.streetAddress}</p>
    <p style="margin-top:10px">
      <a href="/about/" style="color:var(--accent);text-decoration:none;border-bottom:1px dashed rgba(0,212,255,0.35)">О компании</a>
      &nbsp;·&nbsp; ИНН {company.inn} &nbsp;·&nbsp; ОГРН {company.ogrn} &nbsp;·&nbsp; работаем с {company.founded} года
    </p>
    <p style="margin-top:6px">
      СРО строительство: {company.sro.construction.number} &nbsp;·&nbsp;
      СРО проектирование: {company.sro.design.number} &nbsp;·&nbsp;
      Лицензия МЧС: {company.license.mchs}
    </p>
    <p style="margin-top:10px">© {new Date().getFullYear()} nmaus.ru · Все права защищены &nbsp;·&nbsp; <a href="/politika-pdn/" style="color:var(--text-mute);text-decoration:none;border-bottom:1px dashed rgba(255,255,255,.2)">Политика обработки персональных данных</a></p>
  </footer>

  <div class="sticky-cta" role="region" aria-label="Быстрая связь">
    <a href={`tel:${company.phoneTel}`} class="btn btn-primary">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.8 19.8 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.37 1.9.72 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.35 1.85.59 2.81.72A2 2 0 0 1 22 16.92z"/></svg>
      Позвонить
    </a>
    <a href={`https://wa.me/${company.whatsapp}`} class="btn btn-secondary" rel="nofollow">
      <svg viewBox="0 0 24 24" fill="currentColor"><path d="M17.5 14.4c-.3-.1-1.7-.8-2-.9-.3-.1-.5-.1-.7.1-.2.3-.8.9-.9 1.1-.2.2-.3.2-.6.1-.3-.1-1.2-.4-2.4-1.5-.9-.8-1.5-1.8-1.6-2.1-.2-.3 0-.4.1-.6.1-.1.3-.3.4-.5.1-.2.2-.3.3-.5 0-.2 0-.4-.1-.5-.1-.1-.6-1.5-.9-2.1-.2-.5-.5-.4-.7-.5-.2 0-.4 0-.6 0-.2 0-.5.1-.8.4-.3.3-1.1 1.1-1.1 2.7 0 1.6 1.1 3.1 1.3 3.3.2.2 2.3 3.5 5.5 4.8.8.3 1.4.5 1.8.6.8.3 1.5.2 2 .1.6-.1 1.7-.7 2-1.4.2-.7.2-1.2.2-1.4-.1-.2-.3-.3-.6-.4zM12 2a10 10 0 0 0-10 10c0 1.8.5 3.5 1.3 5L2 22l5.1-1.3c1.4.8 3.1 1.3 4.9 1.3a10 10 0 0 0 0-20z"/></svg>
      WhatsApp
    </a>
  </div>

  <script is:inline>
    document.querySelectorAll('.faq .qa').forEach(q => {
      q.addEventListener('toggle', () => {
        if (q.open) document.querySelectorAll('.faq .qa[open]').forEach(o => { if (o !== q) o.open = false; });
      });
    });
  </script>
  {company.metrikaId && (
    <>
      <script is:inline define:vars={{ metrikaId: company.metrikaId }}>
        (function(m,e,t,r,i,k,a){m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};
        m[i].l=1*new Date();
        for (var j=0;j<document.scripts.length;j++){if(document.scripts[j].src===r){return;}}
        k=e.createElement(t),a=e.getElementsByTagName(t)[0],k.async=1,k.src=r,a.parentNode.insertBefore(k,a)})
        (window, document, 'script', 'https://mc.yandex.ru/metrika/tag.js?id=' + metrikaId, 'ym');

        ym(Number(metrikaId), 'init', {
          ssr: true,
          webvisor: true,
          clickmap: true,
          ecommerce: 'dataLayer',
          referrer: document.referrer,
          url: location.href,
          trackLinks: true,
          accurateTrackBounce: true
        });
      </script>
      <noscript><div><img src={`https://mc.yandex.ru/watch/${company.metrikaId}`} style="position:absolute;left:-9999px" alt="" /></div></noscript>
    </>
  )}
</body>
</html>
