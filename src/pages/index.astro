---
import BaseLayout from '../layouts/BaseLayout.astro';
import TrebsaCase from '../components/TrebsaCase.astro';
import company from '../data/company.json';
import services from '../data/services.json';
import regions from '../data/regions.json';
import cities from '../data/cities.json';

const canonical = `${company.site}/`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${company.site}/#org`,
      name: company.legalName,
      alternateName: company.name,
      url: `${company.site}/`,
      telephone: company.phone,
      email: company.email,
      foundingDate: company.founded,
      address: { '@type': 'PostalAddress', ...company.legalAddress },
      location: { '@type': 'PostalAddress', ...company.workAddress },
      identifier: [
        { '@type': 'PropertyValue', name: 'ИНН', value: company.inn },
        { '@type': 'PropertyValue', name: 'ОГРН', value: company.ogrn },
        { '@type': 'PropertyValue', name: 'КПП', value: company.kpp }
      ],
      contactPoint: [
        {
          '@type': 'ContactPoint',
          telephone: company.phone,
          contactType: 'customer service',
          areaServed: 'RU',
          availableLanguage: 'ru',
          hoursAvailable: company.hours.spec.map(h => ({ '@type': 'OpeningHoursSpecification', ...h }))
        }
      ],
      areaServed: Object.values(regions).map(r => ({ '@type': 'AdministrativeArea', name: r.nameFull })),
      hasCredential: [
        { '@type': 'EducationalOccupationalCredential', credentialCategory: 'СРО строительство', name: company.sro.construction.name, identifier: company.sro.construction.number },
        { '@type': 'EducationalOccupationalCredential', credentialCategory: 'СРО проектирование', name: company.sro.design.name, identifier: company.sro.design.number },
        { '@type': 'EducationalOccupationalCredential', credentialCategory: 'Лицензия МЧС', identifier: company.license.mchs }
      ],
      aggregateRating: {
        '@type': 'AggregateRating',
        ratingValue: company.rating.value,
        ratingCount: company.rating.count,
        bestRating: '5', worstRating: '1'
      },
      sameAs: Object.values(company.social).filter(Boolean)
    },
    {
      '@type': 'WebSite',
      '@id': `${company.site}/#site`,
      url: `${company.site}/`,
      name: `${company.name} — НефтеМонтажАвтоматика`,
      alternateName: [company.name, company.fullName, company.legalName],
      publisher: { '@id': `${company.site}/#org` },
      inLanguage: 'ru-RU'
    },
    {
      '@type': 'FAQPage',
      mainEntity: [
        { '@type': 'Question', name: 'С какого года работает НМА и какой у вас опыт?', acceptedAnswer: { '@type': 'Answer', text: `ООО «НефтеМонтажАвтоматика» работает с 2011 года. За 14 лет выполнены объекты для Башнефть-Полюс, ННК-Северная нефть, ЛУКОЙЛ, Транснефть, Зарубежнефть в Республике Коми и НАО. Построено более 250 км ВЛ, сдано 30+ подстанций.` } },
        { '@type': 'Question', name: 'В каких регионах работает НМА?', acceptedAnswer: { '@type': 'Answer', text: 'НМА специализируется на Республике Коми (9 городов: Усинск, Ухта, Сыктывкар, Воркута, Инта, Печора, Сосногорск, Емва, Микунь) и Ненецком автономном округе (Нарьян-Мар). Основная база — г. Усинск.' } },
        { '@type': 'Question', name: 'Какие лицензии и допуски есть у НМА?', acceptedAnswer: { '@type': 'Answer', text: `НМА имеет: допуск СРО на строительство (${company.sro.construction.number}), допуск СРО на проектирование (${company.sro.design.number}), лицензию МЧС (${company.license.mchs}), аккредитованную электролабораторию до 35 кВ (Ростехнадзор).` } },
        { '@type': 'Question', name: 'Выполняете ли вы работы под ключ?', acceptedAnswer: { '@type': 'Answer', text: 'Да, НМА — подрядчик полного цикла: проектирование, поставка оборудования, строительство, монтаж, пусконаладка (ПНР), испытания ЭТЛ, сдача Ростехнадзору. Один договор, один ответственный.' } },
        { '@type': 'Question', name: 'Как получить коммерческое предложение?', acceptedAnswer: { '@type': 'Answer', text: `Позвоните ${company.phoneDisplay} или напишите на ${company.email}. Инженер выезжает на объект в течение 24–48 часов. КП готовим в течение 3–5 рабочих дней после получения ТЗ.` } }
      ]
    }
  ]
};

const serviceList = Object.values(services);
const regionList = Object.values(regions);
const cityList = Object.values(cities);

const clients = [
  'Башнефть-Полюс',
  'ННК-Северная нефть',
  'ЛУКОЙЛ-энергосети',
  'Зарубежнефть-добыча Харьяга',
  'Транснефть-Север',
  'АО Комнедра',
  'РН-Бурение',
  'НГК Горный',
  'ПАО Т-Плюс'
];

const metrics = [
  { num: '14 лет', label: 'на рынке нефтегаза' },
  { num: '250+ км', label: 'ВЛ построено' },
  { num: '30+', label: 'подстанций сдано' },
  { num: '9', label: 'видов работ' },
  { num: '2 СРО', label: 'строительство и проектирование' },
  { num: 'Лиц. МЧС', label: 'монтаж систем ОПС' }
];

const iconSvg: Record<string, string> = {
  tower: '<path d="M12 2v20M6 22l6-20 6 20M4 22h16M7 10h10M5 16h14"/>',
  lamp: '<path d="M9 18h6M10 22h4M12 2a7 7 0 0 1 4 12.7V17H8v-2.3A7 7 0 0 1 12 2z"/>',
  building: '<rect x="4" y="2" width="16" height="20" rx="1"/><path d="M8 6h2M8 10h2M8 14h2M14 6h2M14 10h2M14 14h2M10 22v-4h4v4"/>',
  chip: '<rect x="5" y="5" width="14" height="14" rx="2"/><path d="M9 9h6v6H9zM4 9h2M4 15h2M18 9h2M18 15h2M9 4v2M15 4v2M9 18v2M15 18v2"/>',
  wrench: '<path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>',
  pipe: '<path d="M4 12h6M14 12h6M10 6v12M14 6v12"/><circle cx="10" cy="12" r="3"/><circle cx="14" cy="12" r="3"/>',
  flame: '<path d="M12 2s4 4 4 9a4 4 0 0 1-8 0c0-2 1-3 1-3s-3 2-3 6a6 6 0 0 0 12 0c0-7-6-12-6-12z"/>',
  shield: '<path d="M20 12a8 8 0 1 1-16 0 8 8 0 0 1 16 0z"/><path d="M12 8v4l3 2"/>',
  badge: '<path d="M12 2l9 4v6c0 5-3.8 9.5-9 10-5.2-.5-9-5-9-10V6l9-4z"/>'
};
---

<BaseLayout
  title={`${company.name} — Строительство ВЛ, ЛЭП, подстанций, АСУТП в Коми и НАО`}
  description={`${company.legalName} — строительство ВЛ и ЛЭП, РУ и ПС, энергоцентров, нефтепроводов, АСУТП, ПНР и ШМР, электрообогрев, изоляция, ОПС в Республике Коми и НАО. Работаем с 2011 года. СРО строительство и проектирование. Лицензия МЧС.`}
  canonical={canonical}
  jsonLd={jsonLd}
>

<main>

<!-- HERO -->
<section class="hero" aria-labelledby="hero-title">
  <div class="hero-backdrop-anim" aria-hidden="true">
    <svg viewBox="0 0 400 300" xmlns="http://www.w3.org/2000/svg" style="position:absolute;inset:0;width:100%;height:100%;pointer-events:none;opacity:.5">
      <defs>
        <radialGradient id="hgA" cx="80%" cy="5%" r="55%"><stop offset="0%" stop-color="rgba(240,114,0,.20)"/><stop offset="100%" stop-color="transparent"/></radialGradient>
        <radialGradient id="hgB" cx="10%" cy="25%" r="50%"><stop offset="0%" stop-color="rgba(30,101,212,.15)"/><stop offset="100%" stop-color="transparent"/></radialGradient>
        <radialGradient id="hgC" cx="50%" cy="100%" r="60%"><stop offset="0%" stop-color="rgba(232,200,64,.08)"/><stop offset="100%" stop-color="transparent"/></radialGradient>
      </defs>
      <rect width="100%" height="100%" fill="url(#hgA)"/>
      <rect width="100%" height="100%" fill="url(#hgB)"/>
      <rect width="100%" height="100%" fill="url(#hgC)"/>
      <path d="M0 150 Q 80 80 160 140 T 320 100 T 440 130" stroke="rgba(240,114,0,.13)" stroke-width="1.5" fill="none"/>
      <path d="M0 200 Q 100 140 200 180 T 400 160" stroke="rgba(30,101,212,.10)" stroke-width="1" fill="none"/>
    </svg>
  </div>

  <div class="hero-status">
    <span class="hero-status-pulse" aria-hidden="true"><span class="hero-status-dot"></span></span>
    <span class="hero-status-text">Принимаем заявки · инженер выезжает в течение 24–48 часов</span>
  </div>

  <div class="hero-badge">
    <span>Республика&nbsp;Коми · НАО · с 2011 года</span>
  </div>

  <h1 id="hero-title" class="hero-title-main">
    <em>НефтеМонтажАвтоматика</em>
    <span class="hero-title-line">строит объекты&nbsp;нефтегаза</span>
  </h1>

  <p class="hero-sub">
    Строительство ВЛ и ЛЭП, подстанций, энергоцентров, нефтепроводов и систем автоматизации на объектах нефтегазового комплекса. СРО строительство и проектирование. Лицензия МЧС. С 2011 года.
  </p>

  <div class="hero-meta">
    <div class="hero-meta-item"><span class="hero-meta-num">14</span><span class="hero-meta-label">лет<br/>опыта</span></div>
    <div class="hero-meta-divider" aria-hidden="true"></div>
    <div class="hero-meta-item"><span class="hero-meta-num">250<small>+</small></span><span class="hero-meta-label">км ВЛ<br/>построено</span></div>
    <div class="hero-meta-divider" aria-hidden="true"></div>
    <div class="hero-meta-item"><span class="hero-meta-num">30<small>+</small></span><span class="hero-meta-label">подстанций<br/>сдано</span></div>
    <div class="hero-meta-divider" aria-hidden="true"></div>
    <div class="hero-meta-item"><span class="hero-meta-num">9</span><span class="hero-meta-label">видов<br/>работ</span></div>
  </div>

  <div class="trust-strip">
    <span class="trust-chip"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>СРО строительство</span>
    <span class="trust-chip"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>СРО проектирование</span>
    <span class="trust-chip"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>Лицензия МЧС</span>
    <span class="trust-chip"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>ЭТЛ&nbsp;35&nbsp;кВ</span>
  </div>

  <div class="cta-group">
    <a href={`tel:${company.phoneTel}`} class="btn btn-primary btn-cta-live">
      <span class="btn-pulse" aria-hidden="true"><span class="btn-pulse-dot"></span></span>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.8 19.8 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.37 1.9.72 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.35 1.85.59 2.81.72A2 2 0 0 1 22 16.92z"/></svg>
      <span class="btn-cta-text"><span class="btn-cta-num">{company.phoneDisplay}</span><span class="btn-cta-hint">Звоните — отвечаем сразу</span></span>
    </a>
    <a href={`mailto:${company.email}`} class="btn btn-secondary">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><path d="M22 6l-10 7L2 6"/></svg>
      Написать на почту
    </a>
  </div>
</section>

<!-- METRICS -->
<div class="stats" aria-label="Ключевые показатели НМА">
  {metrics.map(m => (
    <div class="stat">
      <div class="stat-num">{m.num}</div>
      <div class="stat-label">{m.label}</div>
    </div>
  ))}
</div>

<!-- SERVICES -->
<section aria-labelledby="services-title">
  <span class="section-label">Виды работ</span>
  <h2 id="services-title" class="section-title">9 направлений строительства и монтажа</h2>
  <p class="section-sub">НМА выполняет полный комплекс строительно-монтажных работ на объектах нефтегазового комплекса Республики Коми и НАО.</p>
  <div class="services">
    {serviceList.map(svc => (
      <a href={`/uslugi/${svc.slug}/`} class="svc" style="color:inherit;text-decoration:none;display:block">
        <div class="svc-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={iconSvg[svc.heroIcon] || iconSvg.badge}></svg>
        </div>
        <h3>{svc.title}</h3>
        <p>{svc.tagline}</p>
        <span class="svc-tag">{svc.stats[0].num} {svc.stats[0].label}</span>
      </a>
    ))}
  </div>
</section>

<!-- REGIONS -->
<section aria-labelledby="regions-title">
  <span class="section-label">География</span>
  <h2 id="regions-title" class="section-title">Работаем в Республике Коми и НАО</h2>
  <p class="section-sub">НМА специализируется на объектах нефтегазового комплекса Севера. Основная база — Усинск (Республика Коми). Работаем вахтовым методом на удалённых промыслах НАО.</p>
  <div class="services">
    {regionList.map(r => (
      <a href={`/${r.slug}/`} class="svc" style="color:inherit;text-decoration:none;display:block">
        <h3>{r.nameFull}</h3>
        <p>{r.description}</p>
        <span class="svc-tag">{r.cities.length} {r.cities.length === 1 ? 'город' : 'города'} · 9 услуг</span>
      </a>
    ))}
  </div>
</section>

<!-- FLAGSHIP CASE -->
<TrebsaCase />

<!-- CLIENTS -->
<section aria-labelledby="clients-title">
  <span class="section-label">Заказчики</span>
  <h2 id="clients-title" class="section-title">Работаем с лидерами нефтегаза</h2>
  <p class="section-sub">НМА — подрядчик крупнейших нефтегазовых компаний, работающих в Республике Коми и НАО.</p>
  <div class="services">
    {clients.map(c => (
      <div class="svc">
        <div style="display:flex;align-items:center;gap:8px;margin-bottom:8px">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" style="width:16px;height:16px;color:var(--success)"><path d="M20 6L9 17l-5-5"/></svg>
          <span style="font-size:14.5px;font-weight:700">{c}</span>
        </div>
      </div>
    ))}
  </div>
</section>

<!-- CITIES -->
<section aria-labelledby="cities-title">
  <span class="section-label">Города присутствия</span>
  <h2 id="cities-title" class="section-title">Работаем по всему Северу</h2>
  <p class="section-sub">Выберите свой город — получите информацию о наших услугах с учётом местной промышленной специфики.</p>
  <div class="cities">
    {cityList.map(c => (
      <a href={`/gorod/${c.slug}/`} class="city">
        <span class="city-dot"></span>
        {c.name}
      </a>
    ))}
  </div>
</section>

<!-- FEATURES -->
<section aria-labelledby="features-title">
  <span class="section-label">Почему НМА</span>
  <h2 id="features-title" class="section-title">Надёжный подрядчик для Севера</h2>
  <div class="features">
    <div class="feat">
      <div class="feat-top">
        <div class="feat-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l9 4v6c0 5-3.8 9.5-9 10-5.2-.5-9-5-9-10V6l9-4z"/></svg>
        </div>
        <h3>СРО, лицензии, электролаборатория</h3>
      </div>
      <p>Два допуска СРО (строительство с 2023 г., проектирование с 2014 г.), лицензия МЧС, собственная аккредитованная электролаборатория до 35 кВ.</p>
    </div>
    <div class="feat">
      <div class="feat-top">
        <div class="feat-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="10" r="3"/><path d="M12 2a8 8 0 0 0-8 8c0 6 8 12 8 12s8-6 8-12a8 8 0 0 0-8-8z"/></svg>
        </div>
        <h3>База в Усинске, вахта на промыслах</h3>
      </div>
      <p>Основная база — Усинск (Республика Коми). Работаем вахтовым методом на промыслах всего Усинского района и НАО.</p>
    </div>
    <div class="feat">
      <div class="feat-top">
        <div class="feat-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M16 13H8M16 17H8M10 9H8"/></svg>
        </div>
        <h3>Полный цикл — один подрядчик</h3>
      </div>
      <p>Проектирование, поставка, строительство, монтаж, ПНР, сдача Ростехнадзору. Один ответственный — НМА.</p>
    </div>
    <div class="feat">
      <div class="feat-top">
        <div class="feat-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
        </div>
        <h3>14 лет опыта на нефтегазе</h3>
      </div>
      <p>С 2011 года выполнили объекты для Башнефть-Полюс, ННК, ЛУКОЙЛ, Транснефть, Зарубежнефть в Коми и НАО.</p>
    </div>
  </div>
</section>

<!-- FAQ -->
<section aria-labelledby="faq-title">
  <span class="section-label">Вопросы и ответы</span>
  <h2 id="faq-title" class="section-title">Частые вопросы о НМА</h2>
  <div class="faq">
    <details class="qa"><summary>С какого года работает НМА и какой у вас опыт?</summary><div class="qa-body">ООО «НефтеМонтажАвтоматика» работает с 2011 года. За 14 лет выполнены объекты для Башнефть-Полюс, ННК-Северная нефть, ЛУКОЙЛ, Транснефть, Зарубежнефть в Республике Коми и НАО. Построено более 250 км ВЛ, сдано 30+ подстанций.</div></details>
    <details class="qa"><summary>В каких регионах работает НМА?</summary><div class="qa-body">НМА специализируется на Республике Коми (9 городов: Усинск, Ухта, Сыктывкар, Воркута, Инта, Печора, Сосногорск, Емва, Микунь) и Ненецком автономном округе (Нарьян-Мар). Основная база — г. Усинск.</div></details>
    <details class="qa"><summary>Какие лицензии и допуски есть у НМА?</summary><div class="qa-body">НМА имеет: допуск СРО на строительство (СРО-С-246-13062012), допуск СРО на проектирование (СРО-П-174-01102012), лицензию МЧС на монтаж ОПС (Л014-00101-50/04678717), аккредитованную электролабораторию до 35 кВ (Ростехнадзор).</div></details>
    <details class="qa"><summary>Выполняете ли вы работы «под ключ»?</summary><div class="qa-body">Да, НМА — подрядчик полного цикла: проектирование, поставка оборудования, строительство, монтаж, пусконаладка (ПНР), испытания ЭТЛ, сдача Ростехнадзору. Один договор, один ответственный.</div></details>
    <details class="qa"><summary>Работаете ли на удалённых месторождениях вахтовым методом?</summary><div class="qa-body">Да, вахтовый метод — основной формат работы на промыслах. Организуем логистику, проживание, питание и ротацию персонала. Работали на объектах в 300+ км от ближайшего населённого пункта.</div></details>
    <details class="qa"><summary>Как получить коммерческое предложение?</summary><div class="qa-body">Позвоните по номеру {company.phoneDisplay} или напишите на {company.email}. Инженер выезжает на объект для осмотра в течение 24–48 часов. КП готовим в течение 3–5 рабочих дней после получения ТЗ.</div></details>
  </div>
</section>

<!-- CONTACT -->
<section id="contact" aria-labelledby="contact-title">
  <span class="section-label">Контакты</span>
  <h2 id="contact-title" class="section-title">Обсудить проект</h2>
  <div class="contact-card">
    <h3>{company.legalName}</h3>
