---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeroBackdrop from '../../components/HeroBackdrop.astro';
import TrebsaCase from '../../components/TrebsaCase.astro';
import company from '../../data/company.json';
import { organization } from '../../data/organization';
import services from '../../data/services.json';
import regions from '../../data/regions.json';

const canonical = `${company.site}/about/`;

const jsonLd = { '@context': 'https://schema.org', ...organization };

const serviceList = Object.values(services);
---

<BaseLayout
  title={`О компании ${company.legalName} — строительство объектов нефтегаза в Коми и НАО`}
  description={`${company.legalName} (${company.name}) — строительная компания с 2011 года. ИНН ${company.inn}, ОГРН ${company.ogrn}. СРО строительство и проектирование. Лицензия МЧС. Работаем в Республике Коми и НАО.`}
  canonical={canonical}
  jsonLd={jsonLd}
>

<nav class="crumbs" aria-label="Хлебные крошки">
  <a href="/">Главная</a>
  <span class="sep">›</span>
  <span aria-current="page">О компании</span>
</nav>

<main>

<section class="hero hero-featured" aria-labelledby="about-hero">
  <HeroBackdrop />
  <div class="hero-badge">О компании</div>
  <h1 id="about-hero">{company.legalName} <em>— строитель объектов Севера</em></h1>
  <p class="hero-sub">Строительная компания, специализирующаяся на объектах нефтегазового комплекса Республики Коми и НАО. Работаем с 2011 года. Выполняем полный цикл строительно-монтажных работ.</p>
</section>

<div class="stats">
  <div class="stat"><div class="stat-num">2011</div><div class="stat-label">год основания</div></div>
  <div class="stat"><div class="stat-num">С 2011</div><div class="stat-label">работаем в нефтегазе</div></div>
  <div class="stat"><div class="stat-num">9</div><div class="stat-label">видов работ</div></div>
</div>

<section aria-labelledby="about-facts">
  <span class="section-label">Реквизиты</span>
  <h2 id="about-facts" class="section-title">Юридическая информация</h2>
  <div class="features">
    <div class="feat">
      <div class="feat-top">
        <div class="feat-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg></div>
        <h3>Реквизиты</h3>
      </div>
      <p style="font-size:13px;line-height:1.8">
        <strong>Полное наименование:</strong> {company.legalName}<br/>
        <strong>ИНН:</strong> {company.inn}<br/>
        <strong>ОГРН:</strong> {company.ogrn}<br/>
        <strong>КПП:</strong> {company.kpp}<br/>
        <strong>Дата регистрации:</strong> 02.12.2011
      </p>
    </div>
    <div class="feat">
      <div class="feat-top">
        <div class="feat-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0z"/><circle cx="12" cy="10" r="3"/></svg></div>
        <h3>Адреса</h3>
      </div>
      <p style="font-size:13px;line-height:1.8">
        <strong>Юридический:</strong><br/>
        {company.legalAddress.postalCode}, {company.legalAddress.addressRegion}, {company.legalAddress.addressLocality}, {company.legalAddress.streetAddress}<br/><br/>
        <strong>Фактический:</strong><br/>
        {company.workAddress.postalCode}, {company.workAddress.addressRegion}, {company.workAddress.addressLocality}, {company.workAddress.streetAddress}<br/><br/>
        <strong>Почтовый:</strong><br/>
        {company.postalAddress.postalCode}, {company.postalAddress.addressRegion}, {company.postalAddress.addressLocality}, а. я. {company.postalAddress.postOfficeBoxNumber}<br/><br/>
        <strong>Производственная база:</strong><br/>
        {company.productionAddress.addressRegion}, {company.productionAddress.addressLocality}, {company.productionAddress.streetAddress}
      </p>
    </div>
    <div class="feat">
      <div class="feat-top">
        <div class="feat-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l9 4v6c0 5-3.8 9.5-9 10-5.2-.5-9-5-9-10V6l9-4z"/></svg></div>
        <h3>СРО и лицензии</h3>
      </div>
      <p style="font-size:13px;line-height:1.8">
        <strong>СРО строительство:</strong><br/>
        {company.sro.construction.name}<br/>
        № {company.sro.construction.number}<br/>
        Рег. номер НМА: {company.sro.construction.memberNumber}<br/>
        С {company.sro.construction.joined}<br/><br/>
        <strong>СРО проектирование:</strong><br/>
        {company.sro.design.name}<br/>
        № {company.sro.design.number}<br/>
        Рег. номер НМА: {company.sro.design.memberNumber}<br/>
        С {company.sro.design.joined}
      </p>
    </div>
    <div class="feat">
      <div class="feat-top">
        <div class="feat-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><path d="M9 22V12h6v10"/></svg></div>
        <h3>МЧС и электролаборатория</h3>
      </div>
      <p style="font-size:13px;line-height:1.8">
        <strong>Лицензия МЧС:</strong><br/>
        № {company.license.mchs}<br/>
        от {company.license.mchsDate}<br/>
        {company.license.mchsDesc}<br/><br/>
        <strong>Электролаборатория:</strong><br/>
        Свид. {company.electricLabCerts[0].number} от {company.electricLabCerts[0].date} — {company.electricLabCerts[0].type}, {company.electricLabCerts[0].maxVoltage} (действ. до {company.electricLabCerts[0].validUntil})<br/>
        Свид. {company.electricLabCerts[1].number} от {company.electricLabCerts[1].date} — {company.electricLabCerts[1].type}, {company.electricLabCerts[1].maxVoltage}<br/>
        Ростехнадзор · Центральное управление
      </p>
    </div>
  </div>
</section>

<section aria-labelledby="about-services">
  <span class="section-label">Услуги</span>
  <h2 id="about-services" class="section-title">Что мы строим и монтируем</h2>
  <div class="services">
    {serviceList.map(svc => (
      <a href={`/uslugi/${svc.slug}/`} class="svc" style="color:inherit;text-decoration:none;display:block">
        <h3>{svc.title}</h3>
        <p>{svc.tagline}</p>
        <span class="svc-tag">Подробнее →</span>
      </a>
    ))}
  </div>
</section>

<TrebsaCase />

<section id="contact" aria-labelledby="about-contact">
  <span class="section-label">Контакты</span>
  <h2 id="about-contact" class="section-title">Обсудить проект</h2>
  <div class="contact-card">
    <h3>{company.legalName}</h3>
    <div class="contact-item">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.8 19.8 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.37 1.9.72 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.35 1.85.59 2.81.72A2 2 0 0 1 22 16.92z"/></svg>
      <div><a href={`tel:${company.phoneTel}`}>{company.phoneDisplay}</a><small>{company.hours.display}</small></div>
    </div>
    <div class="contact-item">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><path d="M22 6l-10 7L2 6"/></svg>
      <div><a href={`mailto:${company.email}`}>{company.email}</a><small>Ответим в рабочее время</small></div>
    </div>
  </div>
</section>

</main>
</BaseLayout>
